{
  "name": "@modular-admin/admin-core",
  "version": "1.0.0",
  "description": "Yeniden kullanılabilir modüler React 19 Admin Kütüphanesi (Layout, Table, Guard, UsersPage, AuditLogsPage, API Client, AdminShell)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": ">=6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "react-router-dom": "^7.1.5",
    "typescript": "^5.7.2",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0"
  }
}
